# Normalise line endings in the repository; check out with the platform default.
* text=auto

# Shell scripts must keep LF so ./gradlew runs on macOS/Linux.
gradlew text eol=lf
*.sh    text eol=lf

# Windows scripts keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binaries
*.jar   binary
*.png   binary
*.jpg   binary
